.venv/
__pycache__/
*.pyc
.env
runs/
submission.tar.gz

# Local experiment output and superseded submission packages: regenerated locally, not source
baselines/

# gates/: ignore everything except results.json. results.json is the aggregate gate evidence
# (bank stats, priced loss, counters, agent-spec paths; no per-step action streams, no
# competition-data exposure). Replays, draws and confirm logs under gates/ stay local.
/gates/**
!/gates/**/
!/gates/**/results.json

# checkpoints/: accepted baselines. The agent packages stay out of git (near-identical copies of
# agent/), but every manifest.json is tracked, so each accepted baseline's fingerprint is
# recoverable from history and any gate artefact that cites one can still be checked.
# The three lines below must stay in this order: git cannot re-include a file whose parent
# directory is itself excluded, so the directories are un-ignored before the manifests are.
/checkpoints/**
!/checkpoints/**/
!/checkpoints/*/manifest.json

# Kaggle notebooks: large embedded outputs, kept out of git. The leading slash keeps the rule
# from matching any other notebooks/ directory.
/notebooks/

# Raw episode data and the scraped datasets: not needed to build or run the agent
data/archive/
data/kaggriculture-episodes/

# MIT tier-0-5 reference agents (Rayk Kretzschmar). MIT permits redistribution, but they are not
# carried in this public repo. Fetched locally only. Tiers 6-9 and the CC BY-SA CSVs are never fetched.
/harness/bench_agents/reference/

# data/derived/: ALLOWLIST. Everything is ignored by default, because derived outputs can carry
# competition data. Only tracked files need an explicit un-ignore entry below.
/data/derived/**
!/data/derived/**/
!/data/derived/v1v_shop_demand.json
/harness/bench_agents/neighbourhood/
